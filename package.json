{
  "name": "nest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "convex dev --start \"vite dev --port 3000\"",
    "dev:web": "vite dev --port 3000",
